# Copy this file to .streamlit/secrets.toml and fill in your real keys.
# secrets.toml is gitignored — it will never be committed.

SEATS_AERO_API_KEY = "your-seats-aero-key-here"
GMAIL_ADDRESS = "you@gmail.com"
GMAIL_APP_PASSWORD = "your-16-char-app-password"
# Optional: keep balances in a private Gist (GitHub classic token, "gist" scope only).
GIST_TOKEN = "ghp_your-token-here"
